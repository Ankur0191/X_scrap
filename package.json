{
  "name": "x-competitor-intelligence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth:check": "node src/auth/preflight.js",
    "auth:setup": "node src/auth/manual-session.js",
    "collect": "node src/collector/run.js",
    "collect:all": "node src/collector/run.js --all-available",
    "ingest": "node src/ingest/cli.js",
    "ingest:sample": "node src/ingest/cli.js --input data/sample/authorized-sample.jsonl",
    "test": "node --test",
    "collect:ten": "node src/collector/run.js --account tenlifestyle",
    "collect:sgs": "node src/collector/run.js --account SGS_SA",
    "audit:data": "node src/ingest/audit.js",
    "backfill:year": "node src/collector/run.js --backfill --window-days 365",
    "build:window": "node src/intelligence/build-window.js",
    "threads:queue": "node src/collector/build-thread-queue.js",
    "collect:threads": "node src/collector/threads.js",
    "build:conversation": "node src/intelligence/build-conversation.js",
    "collect:cycle": "node src/collector/cycle.js",
    "reason:brief": "python nlp-engine/scripts/generate_brief.py"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  },
  "devDependencies": {}
}
