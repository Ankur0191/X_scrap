# Reserved for future authorized provider integrations.
# Never put X passwords, cookies, browser storage state, or browser profile paths here.
AUTHORIZED_SOURCE=authorized-visible-frontend

# Local GLiNER2.5 extraction
GLINER_MODEL_ID=fastino/gliner2.5-multi-v1
# Use cpu, cuda or mps. Leave unset for automatic CUDA/CPU selection.
# GLINER_DEVICE=cpu
EXTRACTION_PIPELINE_VERSION=0.1.0

# Optional strategic reasoning provider; not enabled until configured by the operator.
# Use any OpenAI-compatible Chat Completions endpoint (local or hosted).
# REASONING_BASE_URL=http://127.0.0.1:11434/v1
# REASONING_API_KEY=
# REASONING_MODEL=
# REASONING_JSON_MODE=1

# TIC X raw-source sync to the TICRivalmap Supabase project
SUPABASE_URL=https://aryztdrywvkbqyjvjqqz.supabase.co
SUPABASE_EXPECTED_PROJECT_REF=aryztdrywvkbqyjvjqqz
SUPABASE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# Add the project service_role key locally.
# Never commit a real key or put it in frontend/NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=
