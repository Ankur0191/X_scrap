{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivalmap.ai/schemas/intelligence-brief.schema.json",
  "title": "Rivalmap Rolling Competitor Intelligence Brief",
  "type": "object",
  "required": ["schemaVersion", "domainId", "window", "coverage", "executiveSummary", "signals", "gaps", "opportunities", "actionables", "evidence"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "domainId": { "type": "string", "enum": ["tic", "aspire_lifestyle"] },
    "window": {
      "type": "object",
      "required": ["days", "startInclusive", "endInclusive"],
      "properties": {
        "days": { "type": "integer", "const": 365 },
        "startInclusive": { "type": "string", "format": "date-time" },
        "endInclusive": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["posts", "competitorReplies", "publicThreadReplies", "coverageStatus"],
      "properties": {
        "posts": { "type": "integer", "minimum": 0 },
        "competitorReplies": { "type": "integer", "minimum": 0 },
        "publicThreadReplies": { "type": "integer", "minimum": 0 },
        "coverageStatus": { "type": "string", "enum": ["complete_to_window_boundary", "partial", "not_started", "unknown"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "executiveSummary": { "type": "string" },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signalId", "category", "summary", "trend", "evidenceIds", "confidence"],
        "properties": {
          "signalId": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "trend": { "type": "string", "enum": ["rising", "falling", "stable", "new", "one_off", "unknown"] },
          "volume": { "type": "integer", "minimum": 0 },
          "uniqueAuthors": { "type": "integer", "minimum": 0 },
          "regions": { "type": "array", "items": { "type": "string" } },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "opportunities": { "type": "array", "items": { "type": "object" } },
    "actionables": { "type": "array", "items": { "type": "object" } },
    "entityGraph": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "modelNotes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
