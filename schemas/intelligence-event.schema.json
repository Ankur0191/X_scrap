{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rivalmap.ai/schemas/intelligence-event.schema.json",
  "title": "Rivalmap Evidence-Backed Intelligence Event",
  "type": "object",
  "required": ["schemaVersion", "eventId", "domainId", "subjectOrganization", "signal", "evidence", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "eventId": { "type": "string", "minLength": 1 },
    "domainId": { "type": "string", "enum": ["tic", "aspire_lifestyle"] },
    "subjectOrganization": { "type": "string" },
    "signal": {
      "type": "object",
      "required": ["primaryType", "summary", "confidence"],
      "properties": {
        "primaryType": {
          "type": "string",
          "enum": ["complaint", "praise", "product_launch", "service_change", "partnership", "acquisition", "expansion", "regulatory_change", "contract_win", "incident", "leadership_change", "technology_innovation", "pricing_change", "market_signal", "other"]
        },
        "secondaryTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "summary": { "type": "string" },
        "sentiment": { "type": "string", "enum": ["positive", "negative", "neutral", "mixed", "unclear"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "isCustomerVoice": { "type": ["boolean", "null"] },
        "isOrganizationClaim": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "complaint": {
      "type": ["object", "null"],
      "properties": {
        "complaintType": { "type": ["string", "null"] },
        "journeyStage": { "type": ["string", "null"] },
        "affectedProductOrService": { "type": ["string", "null"] },
        "complainantType": { "type": ["string", "null"] },
        "region": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "level": { "type": "string", "enum": ["country", "state_province", "city", "market", "unknown"] },
            "evidenceBasis": { "type": "string", "enum": ["explicit_in_post", "explicit_in_thread", "organization_location", "indirect_inference", "unknown"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["level", "evidenceBasis", "confidence"],
          "additionalProperties": false
        },
        "issueDescription": { "type": ["string", "null"] },
        "requestedResolution": { "type": ["string", "null"] },
        "resolutionStatus": { "type": "string", "enum": ["unresolved", "resolved", "partially_resolved", "unknown", "not_applicable"] }
      },
      "additionalProperties": true
    },
    "strategicEvent": {
      "type": ["object", "null"],
      "properties": {
        "eventType": { "type": ["string", "null"] },
        "eventDate": { "type": ["string", "null"], "format": "date-time" },
        "productsOrServices": { "type": "array", "items": { "type": "string" } },
        "markets": { "type": "array", "items": { "type": "string" } },
        "partners": { "type": "array", "items": { "type": "string" } },
        "claimedBenefits": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "impact": {
      "type": ["object", "null"],
      "properties": {
        "impactCategory": { "type": ["string", "null"] },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "unknown"] },
        "timeHorizon": { "type": "string", "enum": ["immediate", "short_term", "medium_term", "long_term", "unknown"] },
        "observedImpact": { "type": ["string", "null"] },
        "potentialImpact": { "type": ["string", "null"] },
        "isHypothesis": { "type": "boolean" }
      },
      "required": ["severity", "timeHorizon", "isHypothesis"],
      "additionalProperties": true
    },
    "gapCandidate": {
      "type": ["object", "null"],
      "properties": {
        "gapType": { "type": ["string", "null"] },
        "unmetNeed": { "type": ["string", "null"] },
        "competitorWeaknessEvidence": { "type": "array", "items": { "type": "string" } },
        "alternativeOpportunity": { "type": ["string", "null"] },
        "recurrenceCount": { "type": ["integer", "null"], "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["confidence"],
      "additionalProperties": true
    },
    "actionables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "rationale", "priority", "confidence", "evidenceIds"],
        "properties": {
          "action": { "type": "string" },
          "rationale": { "type": "string" },
          "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low"] },
          "ownerFunction": { "type": ["string", "null"] },
          "successMetric": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourcePostId", "sourceUrl", "quote", "evidenceRole"],
        "properties": {
          "sourcePostId": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceReplyId": { "type": ["string", "null"] },
          "quote": { "type": "string" },
          "start": { "type": ["integer", "null"], "minimum": 0 },
          "end": { "type": ["integer", "null"], "minimum": 0 },
          "evidenceRole": { "type": "string", "enum": ["direct_fact", "customer_claim", "public_account_claim", "organization_claim", "model_interpretation", "counter_evidence"] }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["model", "modelVersion", "createdAt", "analysisVersion"],
      "properties": {
        "model": { "type": "string" },
        "modelVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "analysisVersion": { "type": "string" },
        "humanReviewed": { "type": "boolean", "default": false }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["entityId", "type", "name", "confidence"],
      "properties": {
        "entityId": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "canonicalId": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["relationType", "fromEntityId", "toEntityId", "confidence", "evidenceIds"],
      "properties": {
        "relationType": { "type": "string" },
        "fromEntityId": { "type": "string" },
        "toEntityId": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
